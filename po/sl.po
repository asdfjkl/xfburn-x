#, c-format
msgid "Could not stat %s: %s"
msgstr "Ne morem določiti %s:%s"

#: xfburn/xfburn-transcoder-basic.c:193
#, c-format
msgid "Could not open %s."
msgstr "%s ni bilo mogoče odpreti."

